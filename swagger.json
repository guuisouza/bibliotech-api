    "schemas": {
      "UserLoginDTO": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com",
            "description": "User email address"
          },
          "password": {
            "type": "string",
            "example": "yourPassword123",
            "description": "User password"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "CreateAuthorDTO": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "George Orwell",
