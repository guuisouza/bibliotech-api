          "email",
          "phone",
          "academicRegistration"
        ]
      },
      "UpdatePatchStudentDTO": {
        "type": "object",
        "properties": {}
      },
      "CreateLoanDTO": {
        "type": "object",
        "properties": {
          "studentId": {
            "type": "number",
            "example": 1,
            "description": "the ID of the student who is renting the book"
          },
          "bookId": {
            "type": "number",
            "example": 1,
            "description": "the ID of the book being rented"
          },
          "dueDate": {
            "format": "date-time",
            "type": "string",
            "example": "2025-03-25",
            "description": "the due date to return the loan"
