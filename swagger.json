          },
          "nationality": {
            "type": "string",
            "example": "Britânico",
            "description": "Author's nationality"
          },
          "birthYear": {
            "type": "number",
            "example": 1903,
            "description": "Year of birth of the author"
          }
        },
        "required": [
          "name",
          "nationality",
          "birthYear"
        ]
      },
      "CreateBookDTO": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Animal Farm",
            "description": "Book title"
          },
          "authorId": {
            "type": "number",
            "example": "1",
            "description": "Book author ID"
          },
          "genre": {
            "type": "string",
            "example": "Satire",
            "description": "Main genre of the book"
          },
          "isbn": {
            "type": "string",
            "example": "9788535909553",
            "description": "Book isbn registration"
          },
          "yearPublished": {
            "type": "number",
            "example": 1945,
            "description": "Year the book was published"
          }
        },
        "required": [
          "title",
          "authorId",
          "genre",
          "isbn",
          "yearPublished"
        ]
      },
      "UpdatePatchBookDTO": {
        "type": "object",
        "properties": {}
      },
      "CreateStudentDTO": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Alice Oliveira",
            "description": "Student's full name"
          },
          "email": {
            "type": "string",
            "example": "alice.oliveira@email.com",
            "description": "Student's email"
          },
          "phone": {
            "type": "string",
            "example": "(11) 98765-4321",
            "description": "Student's phone"
          },
          "academicRegistration": {
            "type": "string",
            "example": "2023123456789",
            "description": "Student academic record"
          }
